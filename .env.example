# تنظیمات اتصال به دیتابیس ابری Supabase
# مقادیر زیر را از بخش Project Settings -> API در داشبورد Supabase کپی کرده
# و در فایل .env (برای اجرا روی سیستم خودتان) یا Environment Variables در Vercel قرار دهید:

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
